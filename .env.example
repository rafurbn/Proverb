# GEMINI_API_KEY: Required for Gemini AI & Gemini TTS (bn-BD voiceover) API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Secondary Fallback: ElevenLabs TTS Credentials (Primary voiceover uses free Microsoft Edge TTS bn-BD-NabanitaNeural)
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"
ELEVENLABS_VOICE_ID="YOUR_ELEVENLABS_VOICE_ID"

# Meta Graph API Credentials (Facebook Page Reels Auto-Posting)
FB_PAGE_ID="YOUR_FACEBOOK_PAGE_ID"
FB_PAGE_ACCESS_TOKEN="YOUR_LONG_LIVED_PAGE_ACCESS_TOKEN"

# Daily Cron Schedule (24h format HH:MM) & Timezone
DAILY_CRON_SCHEDULE="0 9 * * *"
CRON_TIMEZONE="Asia/Dhaka"
